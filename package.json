{
  "name": "inshell-art",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:home": "pnpm --filter @inshell/home dev",
    "dev:home:devnet": "pnpm --filter @inshell/home dev:devnet",
    "dev:thought": "pnpm --filter @inshell/thought dev",
    "dev:thought:public-agent": "INSHELL_THOUGHT_USE_REMOTE_AGENT_API=1 INSHELL_THOUGHT_DEV_API_ORIGIN=https://inshell.art VITE_THOUGHT_AGENT_PUBLIC_API_BASE=https://inshell.art/api/thought-agent/v2 pnpm --filter @inshell/thought dev",
    "dev:thought:stack:public-agent": "INSHELL_THOUGHT_USE_REMOTE_AGENT_API=1 INSHELL_THOUGHT_DEV_API_ORIGIN=https://inshell.art VITE_THOUGHT_AGENT_PUBLIC_API_BASE=https://inshell.art/api/thought-agent/v2 node scripts/dev-thought-local-stack.mjs",
    "dev:thought:node": "node scripts/start-thought-anvil.mjs",
    "dev:thought:node:prepare": "node scripts/prepare-thought-anvil.mjs",
    "dev:thought:node:reset": "node scripts/reset-thought-anvil.mjs --confirm-reset",
    "dev:thought:stack": "node scripts/dev-thought-local-stack.mjs",
    "dev:thought:lan": "node scripts/dev-thought-lan-stack.mjs",
    "docs:generate": "node --import tsx scripts/generate-agent-docs.ts",
    "docs:check": "node --import tsx scripts/generate-agent-docs.ts --check",
    "build:home": "corepack pnpm --filter @inshell/home build:prod && corepack pnpm run build:thought:same-origin",
    "build:home:devnet": "pnpm --filter @inshell/home build",
    "build:home:prod": "corepack pnpm --filter @inshell/home build:prod && corepack pnpm run build:thought:same-origin",
    "build:thought": "pnpm --filter @inshell/thought build",
    "build:thought:same-origin": "VITE_THOUGHT_ROUTE_BASE=/thought VITE_PATH_MINT_URL=/path VITE_THOUGHT_URL=/thought VITE_GALLERY_URL=/gallery VITE_THOUGHT_DETAIL_BASE_URL=/thought INSHELL_THOUGHT_OUT_DIR=../../dist/home/thought corepack pnpm --filter @inshell/thought build",
    "test": "pnpm --filter @inshell/home test && pnpm run test:thought-runtime",
    "test:fast": "pnpm --filter @inshell/home test:fast",
    "test:presepolia": "pnpm --filter @inshell/home test:presepolia && pnpm run test:upstream-release-check && pnpm run test:agent-docs-generator",
    "check:upstream-releases": "node scripts/check-upstream-releases.mjs",
    "check:path-upstream": "node scripts/check-upstream-releases.mjs --only path",
    "check:thought-upstream": "node scripts/check-upstream-releases.mjs --only thought",
    "test:upstream-release-check": "node --test scripts/check-upstream-releases.test.mjs",
    "test:agent-docs-generator": "node --import tsx --test scripts/generate-agent-docs.test.ts",
    "test:thought-runtime": "node scripts/check-thought-creative-spec-lock.mjs && node scripts/sync-thought-v2-protocol.mjs --check && node scripts/check-thought-provenance-lock.mjs && node scripts/check-thought-metadata-namespace-lock.mjs && node --test scripts/thought-metadata-portability.test.mjs scripts/thought-v2-contract-release-verifier.test.mjs && node --import tsx scripts/test-thought-runtime.ts && node --import tsx scripts/test-thought-agent-client.ts && node --import tsx --test scripts/thought-agent-run-url.test.ts apps/thought/scripts/thought-agent-dev-run-store.test.ts && node --import tsx --test apps/thought/src/thought-v2-stored-visual.test.ts && node --import tsx --test scripts/thought-production-readiness.test.ts && node --test scripts/thought-anvil-persistence.test.mjs scripts/dev-thought-lan-stack.test.mjs && node --test scripts/thought-panel-ui.test.mjs && pnpm run test:thought-handoff-lab",
    "test:thought-app-contract": "corepack pnpm --filter @inshell/thought exec tsx scripts/test-app-contract-integration.ts",
    "sync:thought-app-contract": "node scripts/sync-thought-v2-app-contract-baseline.mjs",
    "check:thought-app-contract": "node scripts/sync-thought-v2-app-contract-baseline.mjs --check",
    "test:thought-agent-client": "node --import tsx scripts/test-thought-agent-client.ts",
    "test:thought-agent-client:live": "node --import tsx scripts/test-thought-agent-client-live.ts",
    "test:thought-agent-codex:live": "node --import tsx scripts/test-thought-agent-codex-live.ts",
    "test:thought-agent-claude:public": "node --import tsx scripts/test-thought-agent-claude-public.ts",
    "canary:thought-agent-browser-release:codex": "THOUGHT_BROWSER_CANARY_AGENT=codex node --import tsx scripts/test-thought-agent-browser-release-canary.ts",
    "canary:thought-agent-browser-release:claude": "THOUGHT_BROWSER_CANARY_AGENT=claude node --import tsx scripts/test-thought-agent-browser-release-canary.ts",
    "canary:thought-agent-browser-release": "pnpm run canary:thought-agent-browser-release:codex && pnpm run canary:thought-agent-browser-release:claude",
    "canary:thought-agent:local": "pnpm run test:thought-handoff-lab && pnpm run canary:thought-agent-browser-release",
    "handoff:lab:codex": "node --import tsx scripts/thought-handoff-lab.ts",
    "handoff:lab:claude": "node --import tsx scripts/thought-claude-handoff-lab.ts",
    "test:thought-handoff-lab": "node --import tsx --test scripts/thought-handoff-lab.test.ts scripts/thought-claude-handoff-lab.test.ts && node --import tsx scripts/thought-handoff-lab.ts deterministic --out tmp/thought-handoff-lab-tests && node --import tsx scripts/thought-claude-handoff-lab.ts deterministic --out tmp/thought-handoff-lab-tests",
    "test:unit": "pnpm --filter @inshell/home test:unit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit && pnpm --filter @inshell/home type-check:source",
    "check": "pnpm run docs:check && pnpm run test:agent-docs-generator && pnpm run check:upstream-releases && pnpm run test:upstream-release-check && pnpm run pub-boundary:check && pnpm run check:path-contract-release && pnpm run check:thought-v2-artifact && pnpm run check:thought-v2-protocol && pnpm run check:thought-v2-contract-release && pnpm run check:thought-app-contract && pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run test:thought-runtime",
    "check:production": "pnpm run docs:check && pnpm run test:agent-docs-generator && pnpm run check:upstream-releases && pnpm run pub-boundary:check && pnpm run check:path-contract-release && pnpm run check:thought-v2-artifact && pnpm run check:thought-v2-protocol && pnpm run check:thought-v2-contract-release && pnpm run check:thought-app-contract && pnpm run check:thought-production-readiness && pnpm run check:deployment && pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run test:thought-runtime && pnpm run build:home && pnpm run build:thought && git diff --check",
    "check:thought-production-readiness": "node scripts/check-thought-production-readiness.mjs",
    "check:presepolia": "pnpm run docs:check && pnpm run check:upstream-releases && pnpm run pub-boundary:check && pnpm run check:path-contract-release && pnpm --filter @inshell/home lint && pnpm run test:presepolia && pnpm run test:thought-runtime && pnpm run build:home && pnpm run check:deployment && git diff --check",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check:deployment:live": "node scripts/check-deployment.mjs --live",
    "pub-boundary:check": "node scripts/check-pub-boundary.mjs",
    "smoke:api-routes": "node scripts/smoke-cloudflare-api-routes.mjs",
    "smoke:thought-v2-anvil": "node --import tsx scripts/smoke-thought-v2-anvil.ts",
    "deploy:thought-v2-contract-release:anvil": "node scripts/deploy-thought-v2-integration-preview-anvil.mjs",
    "check:web-analytics-token": "node scripts/check-cloudflare-web-analytics-token.mjs",
    "check:thought-renderer-parity": "tsx scripts/check-thought-renderer-parity.ts",
    "check:thought-v2-renderer-parity": "tsx scripts/check-thought-v2-renderer-parity.ts",
    "check:thought-creative-spec": "node scripts/check-thought-creative-spec-lock.mjs",
    "check:thought-provenance": "node scripts/check-thought-provenance-lock.mjs",
    "check:thought-metadata-namespace": "node scripts/check-thought-metadata-namespace-lock.mjs",
    "check:thought-portability": "node scripts/check-thought-portability-readiness.mjs",
    "verify:thought": "node --import tsx scripts/verify-thought-provenance.ts",
    "quality:github": "node scripts/dev-github-quality-loop.mjs",
    "test:dev-quality": "node --test scripts/dev-github-quality-loop.test.mjs",
    "validate:contracts": "node scripts/validate-inshell-contracts.mjs",
    "sync:path-release": "tsx scripts/sync-path-release.ts",
    "sync:path-contract-release": "node scripts/sync-path-contract-release.mjs --from ../path",
    "check:path-contract-release": "node scripts/sync-path-contract-release.mjs --check",
    "sync:thought-release": "tsx scripts/sync-thought-release.ts",
    "sync:thought-v2-artifact": "node scripts/sync-thought-v2-artifact.mjs --from ../THOUGHT",
    "check:thought-v2-artifact": "node scripts/sync-thought-v2-artifact.mjs --check",
    "sync:thought-v2-protocol": "node scripts/sync-thought-v2-protocol.mjs --from ../THOUGHT",
    "check:thought-v2-protocol": "node scripts/sync-thought-v2-protocol.mjs --check",
    "sync:thought-v2-contract-release": "node scripts/sync-thought-v2-contract-release.mjs --from ../THOUGHT",
    "check:thought-v2-contract-release": "node scripts/sync-thought-v2-contract-release.mjs --check",
    "preview:home": "pnpm --filter @inshell/home preview",
    "e2e:staging": "NODE_ENV=staging cypress run --config-file cypress/cypress.config.ts",
    "e2e:prod": "NODE_ENV=prod cypress run --config-file cypress/cypress.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "cypress": "^13.13.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "js-yaml": "4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once@^2.0.0": "3.0.1",
      "@babel/core@^7.0.0": "7.29.6",
      "ajv@^6.0.0": "6.14.0",
      "axios@^1.0.0": "1.18.0",
      "brace-expansion@^1.0.0": "5.0.9",
      "brace-expansion@^2.0.0": "5.0.9",
      "brace-expansion@^5.0.0": "5.0.9",
      "defu@^6.0.0": "6.1.5",
      "diff@^4.0.0": "4.0.4",
      "esbuild": "0.28.1",
      "flatted@^3.0.0": "3.4.2",
      "form-data@^4.0.0": "4.0.6",
      "glob@^10.0.0": "10.5.0",
      "h3@^1.0.0": "1.15.9",
      "js-yaml": "4.3.1",
      "nanoid@^3.0.0": "3.3.18",
      "lodash@^4.0.0": "4.18.1",
      "minimatch@^3.0.0": "3.1.4",
      "minimatch@^5.0.0": "5.1.8",
      "minimatch@^9.0.0": "9.0.7",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "postcss@^8.0.0": "8.5.23",
      "qs@^6.0.0": "6.15.2",
      "rollup@^4.0.0": "4.60.3",
      "tmp@^0.2.0": "0.2.7",
      "uuid@^8.3.2": "11.1.1",
      "uuid@^11.0.0": "11.1.1",
      "vite@^7.0.0": "7.3.5",
      "@solana/rpc-subscriptions-channel-websocket>ws": "8.21.0",
      "@walletconnect/jsonrpc-ws-connection>ws": "7.5.11",
      "ethers>ws": "8.21.0",
      "jsdom>ws": "8.21.0",
      "rpc-websockets>ws": "8.21.0",
      "viem>ws": "8.21.0",
      "yaml@^1.0.0": "1.10.3",
      "yaml@^2.0.0": "2.8.4"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
    }
  }
}
