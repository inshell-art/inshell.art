{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inshell.art/protocol/current/v2/provenance/thought.provenance.v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "mintContext": { "$ref": "#/$defs/mintContext" },
    "process": {
      "oneOf": [
        { "$ref": "#/$defs/manualProcess" },
        { "$ref": "#/$defs/agentRunProcess" }
      ]
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "schema": { "const": "inshell.thought.provenance.v2" },
    "work": { "$ref": "#/$defs/work" }
  },
  "required": ["mintContext", "process", "protocol", "schema", "work"],
  "title": "THOUGHT Provenance V2",
  "type": "object",
  "$defs": {
    "address": {
      "pattern": "^(?!0x0{40}$)0x[0-9a-f]{40}$",
      "type": "string"
    },
    "agentRunAgentDeclaration": {
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/declarationLabel" },
        "source": { "$ref": "#/$defs/agentRunSource" },
        "status": { "const": "declared-unverified" }
      },
      "required": ["label", "source", "status"],
      "type": "object"
    },
    "agentRunModelDeclaration": {
      "additionalProperties": false,
      "properties": {
        "identifier": { "$ref": "#/$defs/publicString" },
        "label": { "$ref": "#/$defs/declarationLabel" },
        "source": { "$ref": "#/$defs/agentRunSource" },
        "status": { "const": "declared-unverified" }
      },
      "required": ["label", "source", "status"],
      "type": "object"
    },
    "agentRunProcess": {
      "additionalProperties": false,
      "properties": {
        "agentDeclaration": { "$ref": "#/$defs/agentRunAgentDeclaration" },
        "kind": { "const": "agent-run" },
        "modelDeclaration": { "$ref": "#/$defs/agentRunModelDeclaration" },
        "transport": { "$ref": "#/$defs/transport" }
      },
      "required": ["agentDeclaration", "kind", "modelDeclaration", "transport"],
      "type": "object"
    },
    "agentRunSource": {
      "enum": ["agent_declared", "connector_observed", "runtime_configured", "unknown"]
    },
    "bytes32": {
      "pattern": "^0x[0-9a-f]{64}$",
      "type": "string"
    },
    "declarationLabel": {
      "minLength": 1,
      "type": "string",
      "x-thought-context-profile": "inshell.thought.context.v2.visible-utf8-64",
      "x-thought-utf8-max-bytes": 64
    },
    "manualAgentDeclaration": {
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/declarationLabel" },
        "source": { "const": "manual" },
        "status": { "const": "declared-unverified" }
      },
      "required": ["label", "source", "status"],
      "type": "object"
    },
    "manualModelDeclaration": {
      "additionalProperties": false,
      "properties": {
        "identifier": { "$ref": "#/$defs/publicString" },
        "label": { "$ref": "#/$defs/declarationLabel" },
        "source": { "const": "manual" },
        "status": { "const": "declared-unverified" }
      },
      "required": ["label", "source", "status"],
      "type": "object"
    },
    "manualProcess": {
      "additionalProperties": false,
      "properties": {
        "agentDeclaration": { "$ref": "#/$defs/manualAgentDeclaration" },
        "kind": { "const": "manual" },
        "modelDeclaration": { "$ref": "#/$defs/manualModelDeclaration" }
      },
      "required": ["agentDeclaration", "kind", "modelDeclaration"],
      "type": "object"
    },
    "mintContext": {
      "additionalProperties": false,
      "properties": {
        "chainId": { "pattern": "^[1-9][0-9]*$", "type": "string" },
        "intendedMinter": { "$ref": "#/$defs/address" },
        "thoughtNft": { "$ref": "#/$defs/address" }
      },
      "required": ["chainId", "intendedMinter", "thoughtNft"],
      "type": "object"
    },
    "nonzeroBytes32": {
      "pattern": "^(?!0x0{64}$)0x[0-9a-f]{64}$",
      "type": "string"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "manifestKeccak256": { "$ref": "#/$defs/nonzeroBytes32" },
        "protocolReleaseId": { "$ref": "#/$defs/nonzeroBytes32" },
        "thoughtSpecHash": { "$ref": "#/$defs/nonzeroBytes32" },
        "thoughtSpecId": { "$ref": "#/$defs/nonzeroBytes32" }
      },
      "required": ["manifestKeccak256", "protocolReleaseId", "thoughtSpecHash", "thoughtSpecId"],
      "type": "object"
    },
    "publicIdentifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$",
      "type": "string",
      "x-thought-utf8-max-bytes": 128
    },
    "publicString": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-thought-public-string-profile": "inshell.thought.public-string.v1",
      "x-thought-utf8-max-bytes": 256
    },
    "terminalLine": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?! )(?!.*  )(?!.* $)[ A-Za-z0-9.,?!:;'\"()/&-]{1,64}$",
      "type": "string",
      "x-thought-line-profile": "inshell.thought.work.v2.terminal-english-64",
      "x-thought-utf8-max-bytes": 64
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "adapter": { "$ref": "#/$defs/publicIdentifier" },
        "provider": { "$ref": "#/$defs/publicIdentifier" },
        "resultEnvelopeKeccak256": { "$ref": "#/$defs/nonzeroBytes32" },
        "route": { "$ref": "#/$defs/publicIdentifier" },
        "runIdHash": { "$ref": "#/$defs/nonzeroBytes32" }
      },
      "required": ["resultEnvelopeKeccak256", "runIdHash"],
      "type": "object"
    },
    "work": {
      "additionalProperties": false,
      "properties": {
        "agentLine": { "$ref": "#/$defs/terminalLine" },
        "agentLineKeccak256": { "$ref": "#/$defs/bytes32" },
        "conversationIdentityHash": { "$ref": "#/$defs/bytes32" },
        "promptLine": { "$ref": "#/$defs/terminalLine" },
        "promptLineKeccak256": { "$ref": "#/$defs/bytes32" },
        "workHash": { "$ref": "#/$defs/bytes32" }
      },
      "required": [
        "agentLine",
        "agentLineKeccak256",
        "conversationIdentityHash",
        "promptLine",
        "promptLineKeccak256",
        "workHash"
      ],
      "type": "object"
    }
  }
}
