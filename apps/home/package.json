{
  "name": "@inshell/home",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_NETWORK=sepolia VITE_PUBLIC_LAUNCH_MODE=sepolia_invite VITE_PATH_RPC_URL=/api/path-rpc VITE_THOUGHT_URL=/thought VITE_GALLERY_URL=/gallery vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:devnet": "vite --mode devnet --host 127.0.0.1 --port 5173 --strictPort",
    "build": "pnpm --dir ../.. docs:check && vite build",
    "build:prod": "pnpm --dir ../.. docs:check && VITE_NETWORK=sepolia VITE_PATH_RPC_URL=/api/path-rpc vite build --mode prod",
    "test": "jest",
    "test:all": "jest --runInBand --coverage=false",
    "test:coverage": "jest --runInBand --runTestsByPath tests/App.test.tsx tests/AuctionCanvas.test.tsx tests/AuctionCanvasPulseFixtures.test.tsx tests/AuctionCanvasLook.test.tsx tests/HeaderWalletCTA.test.tsx tests/InshellTopBar.test.tsx tests/Movements.test.tsx tests/VerifyPathRecord.test.tsx",
    "test:fast": "jest --coverage=false --runTestsByPath tests/num.test.ts tests/pulseCurve.test.ts",
    "test:presepolia": "pnpm run test:unit",
    "test:unit": "pnpm run test:all && pnpm run test:coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "pnpm run type-check:source",
    "type-check:source": "tsc --project tsconfig.typecheck.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@inshell/contracts": "workspace:*",
    "@inshell/ethereum": "workspace:*",
    "@inshell/inshell-shell": "workspace:*",
    "@inshell/shared": "workspace:*",
    "@inshell/utils": "workspace:*",
    "@inshell/wallet": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@types/d3": "^7.4.3",
    "@uidotdev/usehooks": "^2.4.1",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "framer-motion": "^13.1.1",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "viem": "^2.55.19",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cypress": "^1.1.6",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "seedrandom": "^3.0.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
