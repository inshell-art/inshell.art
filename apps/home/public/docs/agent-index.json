  "purpose": "Public, read-only discovery for visitors using their own Agents.",
  "sourceLock": {
    "url": "/docs/source-lock.json",
    "canonicalUrl": "https://inshell.art/docs/source-lock.json",
    "schemaUrl": "/docs/source-lock.schema.json",
    "canonicalSchemaUrl": "https://inshell.art/docs/source-lock.schema.json",
